							"raw": "{\n    \"name\": \"Updated Name\",\n    \"status\": \"inactive\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/public/v2/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["public", "v2", "users", "{{userId}}"]
						}
					}
				},
				{
					"name": "3. Verify Update (GET - 200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test('Name reflects update', function () {",
									"    pm.expect(jsonData.name).to.eql('Updated Name');",
									"});",
									"",
									"pm.test('Status reflects update', function () {",
									"    pm.expect(jsonData.status).to.eql('inactive');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/public/v2/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["public", "v2", "users", "{{userId}}"]
						}
					}
				}
			]
		},
