							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"GetTestUser\",\n    \"email\": \"gettest_{{$randomInt}}@example.com\",\n    \"gender\": \"male\",\n    \"status\": \"active\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/public/v2/users",
							"host": ["{{baseUrl}}"],
							"path": ["public", "v2", "users"]
						}
					}
				},
				{
					"name": "4. Get User by ID (GET - 200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test('Correct user returned', function () {",
									"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('userId'));",
									"});",
									"",
									"pm.test('Name is present', function () {",
									"    pm.expect(jsonData.name).to.not.be.null;",
									"});",
									"",
									"pm.test('Email is present', function () {",
									"    pm.expect(jsonData.email).to.not.be.null;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/public/v2/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["public", "v2", "users", "{{userId}}"]
						}
					}
				}
			]
		},
		{
